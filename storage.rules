rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Archived NSE disclosure PDFs — public read.
    // Sourced from nse.co.ke's public archive, so re-hosting for search
    // is a redistribution rather than a new publication. Writes go via
    // admin SDK from the pipeline service account (bypasses rules).
    match /nse-pdfs/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else — locked down. Explicit allow rules per path
    // above; anything not listed is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
